{
  "rewrites": [
    {
      "source": "/t/:ref",
      "destination": "/api/article?ref=:ref"
    }
  ],
  "headers": [
    {
      "source": "/t/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}